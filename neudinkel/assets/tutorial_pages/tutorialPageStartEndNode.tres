[resource]
script = ExtResource("2_rl132")
Label = "Start- und Endknoten setzen"
Text = "Im Baumodus musst du einen Start- und Endknoten wählen um dir die Algorithmen simulieren zu lassen. Um diese festzulegen klicke zuerst eine Tile an welche du als Startknoten wählen möchtest und dann das Symbol der Flagge unten links damit diese als Startknoten gesetzt wird. Genau neben dem Flaggensymbol befindet sich ein Symbol mit einem Tor dies nutzt man auf dem selben Weg um einen Endknoten zu setzen."
Image = ExtResource("1_pvxiq")
