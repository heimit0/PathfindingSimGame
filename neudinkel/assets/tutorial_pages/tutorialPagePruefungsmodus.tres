script = ExtResource("2_hnouy")
Label = "Prüfungsmodus"
Text = "Im Prüfungsmodus klickst du nacheinander die Tiles an welche laut dem Algorithmus der effizenteste Weg zum Endknoten wären. Wenn du dies richtig ausführst wird das Level als geschafft markiert, sonst musst du es erneut probieren."
