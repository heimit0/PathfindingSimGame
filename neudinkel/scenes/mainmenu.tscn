horizontal_alignment = 1

[node name="RichTextLabel" type="RichTextLabel" parent="AlgoOverview/VBoxContainer/HBoxContainer/DijsktraPanel/VBoxContainer"]
layout_mode = 2
text = "Dijkstra findet den kürzesten Weg in einem Graphen mit nichtnegativen Kantengewichten, indem er allen Knoten eine Distanz zuweist (Startknoten 0, alle anderen ∞) und zu jedem Knoten einen Vorgänger speichert. Er wählt wiederholt den unbesuchten Knoten mit der kleinsten Distanz, prüft für dessen Nachbarn, ob der Weg über diesen Knoten kürzer ist, und aktualisiert gegebenenfalls Distanz und Vorgänger, bevor der Knoten als besucht markiert wird. Dies läuft weiter, bis der Zielknoten besucht ist oder keine erreichbaren Knoten mehr existieren; der kürzeste Weg ergibt sich durch Rückverfolgung der Vorgänger vom Ziel zum Start."
fit_content = true

[node name="ASternPanel" type="Panel" parent="AlgoOverview/VBoxContainer/HBoxContainer"]
material = ExtResource("9_wf3n4")
custom_minimum_size = Vector2(325, 540)
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_styles/panel = SubResource("StyleBoxFlat_h73c4")

[node name="VBoxContainer" type="VBoxContainer" parent="AlgoOverview/VBoxContainer/HBoxContainer/ASternPanel"]
material = ExtResource("9_wf3n4")
custom_minimum_size = Vector2(40, 20)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_right = -15.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20
alignment = 1

[node name="Label" type="Label" parent="AlgoOverview/VBoxContainer/HBoxContainer/ASternPanel/VBoxContainer"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_85riq")
theme_override_font_sizes/font_size = 40
text = "A*"
horizontal_alignment = 1

[node name="RichTextLabel" type="RichTextLabel" parent="AlgoOverview/VBoxContainer/HBoxContainer/ASternPanel/VBoxContainer"]
layout_mode = 2
text = "A* sucht den kürzesten Weg wie Dijkstra, verwendet aber zusätzlich eine Heuristik, die die geschätzte Restentfernung zum Ziel angibt. Für jeden Knoten werden die bisherigen Kosten g und der geschätzte Rest h zu f = g + h kombiniert, und es wird immer der Knoten mit dem kleinsten f ausgewählt. Für seine Nachbarn werden die g-Kosten und Vorgänger aktualisiert, wenn ein besserer Weg gefunden wird; die Suche konzentriert sich so auf vielversprechende Richtungen und endet, wenn das Ziel als bester Knoten ausgewählt wurde, der Weg wird dann über die Vorgänger rekonstruiert."
fit_content = true

