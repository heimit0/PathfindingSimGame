alignment = 1

[node name="Label" type="Label" parent="AlgoOverview/VBoxContainer/HBoxContainer/ASternPanel2/VBoxContainer"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_85riq")
theme_override_font_sizes/font_size = 40
text = "DFS"
horizontal_alignment = 1

[node name="RichTextLabel" type="RichTextLabel" parent="AlgoOverview/VBoxContainer/HBoxContainer/ASternPanel2/VBoxContainer"]
layout_mode = 2
text = "Die Tiefensuche (DFS) durchläuft einen Graphen, indem sie von einem Startknoten aus immer einem noch unbesuchten Nachbarn möglichst weit in die Tiefe folgt. Dazu werden Knoten beim Betreten als besucht markiert, rekursiv oder mit einem Stack weiterverfolgt und bei Sackgassen wieder zurückgegangen, um andere noch unbesuchte Nachbarn zu erkunden. So werden alle erreichbaren Knoten systematisch besucht, und man kann einen Weg zu einem Zielknoten finden, allerdings ohne Garantie, dass dieser Weg der kürzeste ist."
fit_content = true

